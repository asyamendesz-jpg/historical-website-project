# Шаблон для Vercel → Project → Settings → Environment Variables.
# Реальные значения задавайте там как Secret. Файл .env в Git не коммитить.
# Пароли и ключи в чат не присылать.

# Получатель заявок. Обработчик игнорирует получателя из тела запроса.
CONTACT_EMAIL=asya.mendes.z@gmail.com

# SMTP отправителя: ящик, который почтовый сервис разрешает как From.
# Адрес Gmail сам по себе не является SMTP-реквизитами.
# Для smtp.gmail.com нужны 2FA и пароль приложения, не пароль аккаунта.
# Порт 25 на Vercel закрыт; используйте 465 (TLS) или 587 (STARTTLS).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=asya.mendes.z@gmail.com
SMTP_PASS=
SMTP_FROM=asya.mendes.z@gmail.com

ALLOWED_ORIGINS=https://portfo.ru,https://www.portfo.ru
